<Window x:Class="RestaurantMenu.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Меню заведения"
        Height="550" Width="750"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопка «Назад» -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Name="btnBack" Grid.Column="0"
                    Content="← Назад" Width="100" Height="32" Margin="0,0,15,0"
                    Click="BtnBack_Click"
                    Background="#555555" Foreground="White" FontWeight="SemiBold"/>
            <TextBlock Name="lblTitle" Grid.Column="1"
                       FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
        </Grid>

        <!-- Список блюд (до фильтра — чтобы lvDishes успел создаться) -->
        <ListView Name="lvDishes" Grid.Row="1" Height="220" Margin="0,0,0,10"
                  SelectionChanged="LvDishes_SelectionChanged"
                  PreviewMouseLeftButtonDown="LvDishes_PreviewMouseLeftButtonDown">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Название" Width="200" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Цена" Width="100" DisplayMemberBinding="{Binding Price}"/>
                    <GridViewColumn Header="Категория" Width="120" DisplayMemberBinding="{Binding Category}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Фильтр по категориям -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Фильтр: " VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
            <ComboBox Name="cmbFilter" Width="150" SelectionChanged="СmbFilter_SelectionChanged">
                <ComboBoxItem Content="Все" IsSelected="True"/>
                <ComboBoxItem Content="Горячие блюда"/>
                <ComboBoxItem Content="Напитки"/>
                <ComboBoxItem Content="Десерты"/>
            </ComboBox>
        </StackPanel>

        <!-- Панель добавления / изменения блюда -->
        <Border Grid.Row="3" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Name="lblDishPanelTitle" Text="➕ Добавить новое блюдо" FontWeight="Bold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Название:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Name="txtNewDishName" Grid.Row="0" Grid.Column="1" Margin="5,0,10,0"/>

                    <TextBlock Text="Цена:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"/>
                    <TextBox Name="txtNewDishPrice" Grid.Row="0" Grid.Column="3" Width="80" Margin="5,0,10,0"/>

                    <Button Name="btnAddDish" Grid.Row="0" Grid.Column="4"
                            Content="➕ Добавить" Width="110"
                            Click="BtnAddDish_Click"
                            Background="#4CAF50" Foreground="White" FontWeight="Bold"/>

                    <TextBlock Text="Категория:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,10,0,0"/>
                    <ComboBox Name="cmbCategory" Grid.Row="1" Grid.Column="1" Margin="5,10,10,0" SelectedIndex="0">
                        <ComboBoxItem Content="Hot"/>
                        <ComboBoxItem Content="Drink"/>
                        <ComboBoxItem Content="Dessert"/>
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="btnDeleteDish" Content="🗑️ Удалить выбранное"
                    Width="140" Height="35" Margin="0,0,10,0"
                    Click="BtnDeleteDish_Click"
                    Background="#CF6679" Foreground="White"/>
            <Button Name="btnSaveMenu" Content="💾 Сохранить меню"
                    Width="140" Height="35"
                    Click="BtnSaveMenu_Click"
                    Background="#D4AF37" Foreground="Black" FontWeight="Bold"/>
        </StackPanel>

    </Grid>
</Window>
