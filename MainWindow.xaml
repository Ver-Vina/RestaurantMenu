<Window x:Class="RestaurantMenu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RestaurantMenu"
        mc:Ignorable="d"
        Title="RestaurantMenu - Управление меню заведений"
        Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                   Text="📋 Управление меню ресторанов, кафе и кофеен"
                   FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Фильтр по типу заведения -->
        <TextBlock Grid.Row="1" Grid.Column="0" 
                   Text="Тип заведения:" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <ComboBox Grid.Row="1" Grid.Column="1" 
                  Name="cmbEstablishmentType"
                  Margin="0,5,0,10"
                  SelectionChanged="CmbEstablishmentType_SelectionChanged">
            <ComboBoxItem Content="Все" IsSelected="True"/>
            <ComboBoxItem Content="Рестораны"/>
            <ComboBoxItem Content="Кафе"/>
            <ComboBoxItem Content="Кофейни"/>
        </ComboBox>

        <!-- Выбор заведения -->
        <TextBlock Grid.Row="2" Grid.Column="0" 
                   Text="Заведение:" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <ComboBox Grid.Row="2" Grid.Column="1" 
                  Name="cmbEstablishment"
                  Margin="0,5,0,10"
                  DisplayMemberPath="Name"
                  SelectionChanged="CmbEstablishment_SelectionChanged"/>

        <!-- Тип меню (обычное / сезонное) -->
        <TextBlock Grid.Row="3" Grid.Column="0" 
                   Text="Тип меню:" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,5,0,10">
            <RadioButton Name="rbRegular" Content="Обычное" IsChecked="True" 
                         Margin="0,0,20,0" VerticalAlignment="Center"/>
            <RadioButton Name="rbSeasonal" Content="Сезонное" 
                         VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Формат сохранения -->
        <TextBlock Grid.Row="4" Grid.Column="0" 
                   Text="Формат сохранения:" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <ComboBox Grid.Row="4" Grid.Column="1" 
                  Name="cmbSaveFormat"
                  Margin="0,5,0,10"
                  SelectedIndex="0">
            <ComboBoxItem Content="JSON"/>
            <ComboBoxItem Content="XML"/>
        </ComboBox>

        <!-- Карточка выбранного заведения -->
        <Border Grid.Row="5" Grid.ColumnSpan="2" 
                Background="#2D2D2D" CornerRadius="10" 
                Padding="15" Margin="0,10,0,15">
            <StackPanel>
                <TextBlock Name="lblEstablishmentInfo" 
                           Text="Выберите заведение"
                           FontSize="14" Foreground="#AAAAAA"/>
                <Button Name="btnShowMenu" 
                        Content="🍽️ Показать меню"
                        Width="150" Height="35" 
                        Margin="0,10,0,0" HorizontalAlignment="Left"
                        IsEnabled="False"
                        Click="BtnShowMenu_Click"
                        Background="#D4AF37" Foreground="Black"
                        FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Статусная строка -->
        <StatusBar Grid.Row="7" Grid.ColumnSpan="2" 
                   VerticalAlignment="Bottom" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock Name="lblStatus" Text="Готово"/>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>